// Data model. The shape is sketched in docs/ARCHITECTURE.md#data-model-sketch; this file is
// the authority. Only the tables M1.1 needs exist yet — the rest arrive with the milestones
// that use them.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Every service is booked one of two ways, and the whole UI turns on which: instant is teal
/// and says "Book now", request is navy and says "Request a quote".
enum BookingMode {
  instant
  request
}

enum Role {
  customer
  staff
  admin
}

/// The five things the /request form can be about, matching its type picker.
enum RequestType {
  corporate
  group
  visa
  package
  car
}

enum ContactPref {
  whatsapp
  call
  email
}

/// docs/ARCHITECTURE.md#request-pipeline. The customer sees a simplified view of this —
/// "Awaiting quotation" covers everything up to `quoted`.
enum QuoteStatus {
  submitted
  reviewing
  quoted
  negotiating
  accepted
  booked
  expired
  lost
}

/// Phone is the identity here — Bangladesh is a phone-first market and OTP is the planned
/// primary sign-in (M2.1). Email is optional and secondary.
model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  email       String?  @unique
  name        String
  /// AES-256-GCM ciphertext, never the document itself — see lib/field-crypto.ts. An identity
  /// document cannot be reissued the way a password can, so a database dump must not contain
  /// one.
  nidPassport String?  @map("nid_passport")

  /// Notification preferences. Booking updates default on because they are transactional;
  /// marketing defaults off, which is the only defensible default for something nobody asked
  /// for.
  notifyBookingUpdates Boolean @default(true) @map("notify_booking_updates")
  notifyOffers         Boolean @default(false) @map("notify_offers")
  notifyNewsletter     Boolean @default(false) @map("notify_newsletter")
  role        Role     @default(customer)
  /// Argon2id. Only staff have one — customers sign in by phone OTP (M2.1), which is why
  /// this is nullable rather than required.
  passwordHash String? @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quoteRequests QuoteRequest[]
  assignedRequests QuoteRequest[] @relation("assignedStaff")
  requestEvents QuoteRequestEvent[]
  quotations    Quotation[]

  @@map("users")
}

/// A trip too specific for a booking form: 34 people, three hotels, one bus. Submitted by
/// anyone, signed in or not, which is why the contact fields are on the row itself and
/// `user` is optional until accounts exist (M2.x).
model QuoteRequest {
  id     String @id @default(uuid())
  /// REQ-XXXX, the shape the design system's content rules fix. Filled by a Postgres
  /// sequence so two concurrent submissions cannot collide — see the migration.
  ref    String @unique @default(dbgenerated("('REQ-'::text || nextval('quote_request_ref_seq'::regclass))"))
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  requestType  RequestType @map("request_type")
  destinations String
  paxBand      String      @map("pax_band")
  startDate    DateTime?   @map("start_date") @db.Date
  nights       Int?
  budgetBand   String?     @map("budget_band")
  org          String?
  needs        String[]
  notes        String?

  name        String
  phone       String
  email       String?
  contactPref ContactPref @map("contact_pref")

  status       QuoteStatus @default(submitted)
  /// The coordinator who owns the reply. Null means nobody has claimed it.
  assignedToId String?     @map("assigned_to_id")
  assignedTo   User?       @relation("assignedStaff", fields: [assignedToId], references: [id], onDelete: SetNull)

  events     QuoteRequestEvent[]
  quotations Quotation[]

  /// SHA-256 of the submitter's IP. Rate limiting needs to recognise a repeat sender
  /// without the database holding an address that identifies one.
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@index([phone, createdAt])
  @@index([assignedToId, status])
  @@map("quote_requests")
}

enum RequestEventType {
  status_changed
  assigned
  note
  quotation_sent
}

/// A one-time code sent to a phone. The code itself is never stored — only an argon2 hash of
/// it — so a database leak does not hand anyone a working sign-in.
model OtpChallenge {
  id        String    @id @default(uuid())
  phone     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  /// Wrong guesses against this challenge. Past the cap it is dead even if the code is right.
  attempts  Int       @default(0)
  /// Set the moment it is used, so one code can never sign in twice.
  consumedAt DateTime? @map("consumed_at")
  ipHash    String?   @map("ip_hash")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
  @@map("otp_challenges")
}

enum SmsStatus {
  queued
  sent
  failed
}

/// Sent messages, for the same reason email has an outbox: "did the code arrive?" should be
/// answerable from our own records. The body of an OTP is redacted unless the transport is
/// the local console one — see lib/sms/send.ts.
model SmsMessage {
  id        String    @id @default(uuid())
  to        String
  body      String
  template  String
  status    SmsStatus @default(queued)
  transport String
  error     String?
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("sms_messages")
}

/// One row per tracking lookup, so the guessing rate can be limited without keeping counters
/// in memory the way serverless cannot. The IP is hashed; the reference is kept so an actual
/// enumeration attempt is visible afterwards.
model TrackingAttempt {
  id        String   @id @default(uuid())
  ipHash    String   @map("ip_hash")
  ref       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ipHash, createdAt])
  @@map("tracking_attempts")
}

enum EmailStatus {
  queued
  sent
  failed
}

/// Every message the app tries to send, kept whether it succeeded or not. Without this, "did
/// the customer get their quotation?" is answerable only from a third party's dashboard —
/// and not at all before a provider exists.
model EmailMessage {
  id        String      @id @default(uuid())
  to        String
  subject   String
  body      String
  /// Which template produced it: quote_request_received, quote_request_internal, …
  template  String
  /// The request or booking it belongs to, for the audit trail. Deliberately loose: this
  /// table outlives whatever it refers to.
  contextRef String?    @map("context_ref")
  status    EmailStatus @default(queued)
  /// 'console' until a real provider is configured.
  transport String
  error     String?
  sentAt    DateTime?   @map("sent_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([contextRef])
  @@map("email_messages")
}

enum QuotationStatus {
  draft
  sent
  accepted
  expired
  superseded
}

/// A written, itemised price for one request. Several can exist for the same request — a
/// customer who negotiates gets a new one rather than an edited old one, so what was sent on
/// which day stays answerable.
model Quotation {
  id        String       @id @default(uuid())
  requestId String       @map("request_id")
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// [{ description, quantity, unitPrice, amount }] — whole taka, no decimals, which is how
  /// the business quotes. Snapshotted rather than related, because a quotation must keep
  /// reading as it was sent even after prices move.
  lineItems Json

  subtotal Int
  discount Int @default(0)
  total    Int

  /// Per quotation, not a global policy: the "30% to hold" in the brief is unconfirmed (D3).
  depositPercent Int @map("deposit_percent") @default(30)
  depositAmount  Int @map("deposit_amount")

  validUntil DateTime        @map("valid_until") @db.Date
  notes      String?
  status     QuotationStatus @default(draft)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String @map("created_by_name")

  sentAt     DateTime? @map("sent_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([requestId, createdAt])
  @@map("quotations")
}

/// Append-only history: who did what to a request and when. Nothing here is ever updated or
/// deleted — "the customer says they were told X" is answerable only if the record is
/// complete, and a status column alone cannot say who moved it or why.
model QuoteRequestEvent {
  id        String           @id @default(uuid())
  requestId String           @map("request_id")
  request   QuoteRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type      RequestEventType
  /// Null when the actor's account is later removed; the event itself survives.
  actorId   String?          @map("actor_id")
  actor     User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised so history still reads correctly after a staff member leaves.
  actorName String           @map("actor_name")

  fromStatus QuoteStatus? @map("from_status")
  toStatus   QuoteStatus? @map("to_status")
  /// Internal note, or the reason attached to a transition. Never shown to the customer.
  body       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([requestId, createdAt])
  @@map("quote_request_events")
}

/// The twelve-service catalogue from the brief. `slug` carries the ids the front end has
/// always used ("hotels", "houseboat"), so seeded rows line up with the existing UI.
model Service {
  id        String      @id @default(uuid())
  slug      String      @unique
  name      String
  icon      String
  mode      BookingMode
  summary   String
  sort      Int
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([active, sort])
  @@map("services")
}
