# Copy to .env and fill in. .env is git-ignored; never commit a real connection string,
# secret or password.

# Postgres. Neon (the chosen host) gives you this on the project dashboard — take the
# pooled connection string and keep ?sslmode=require.
#   local alternative: `npx prisma dev` prints one, no Docker needed
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Only `prisma migrate dev` needs this — it replays migrations into a scratch database.
# `npx prisma dev` runs one on its own port; on Neon, point it at a second database.
SHADOW_DATABASE_URL=""

# Signs the staff session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (`npx auth secret` now resolves to an unrelated package.) Changing it signs everyone out.
AUTH_SECRET=""

# Email. With no key set, messages are written to the email_messages table and logged to the
# terminal instead of being delivered — the copy and the audit trail are real either way.
# Set RESEND_API_KEY to start actually sending (M1.3).
RESEND_API_KEY=""
EMAIL_FROM="YesTourBD <no-reply@yestourbd.com>"
# Where new-request notifications go. Comma-separated for several people. Unset means the
# desk gets no email — customers still do.
DESK_EMAIL=""

# Encrypts NID and passport numbers in the database (AES-256-GCM). 32 bytes of base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Lose it and those fields become unreadable — they are not recoverable from anything else.
# Change it and existing values stop decrypting, so plan a re-entry, not a swap.
DATA_ENCRYPTION_KEY=""

# SMS, for customer sign-in codes. With no key set, codes print to the terminal instead of
# being sent — the whole OTP flow works locally without spending credits.
# Endpoint defaults to https://bulksmsbd.net/api/smsapi; keep it https, because the key and
# the one-time code travel in the query string.
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_API_URL=""

# The app's own public address, used for links inside emails. Vercel supplies its own; set
# this for a custom domain or another host.
SITE_URL=""

# Only read by `npm run staff:create`, which creates or resets one staff account. Set them
# on the command line rather than leaving a password sitting in this file.
STAFF_EMAIL="test@abc.com"
STAFF_PASSWORD="password"
STAFF_NAME="Admin"
STAFF_PHONE="01927783873"
# staff | admin — defaults to staff
STAFF_ROLE="admin"
